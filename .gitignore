# Pastas Ignoradas
/vendor/
/node_modules/
**/vendor/
**/node_modules/

# Ambientes Locais e Segredos
.env
api/config/.env
*.log

# Dados de produção (anexos, avatares e logs reais não devem ir para o git)
backend/anexos/*
!backend/anexos/.gitkeep
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
!backend/uploads/avatars/.htaccess
backend/logs/*
!backend/logs/.gitkeep
# Cache do HTML Purifier (gerado em tempo de execução)
backend/cache/
error_log
*.tmp

# Arquivos do OS
.DS_Store
Thumbs.db

# Artefatos do Playwright (testes manuais)
.playwright-mcp/

# Composer local (instale globalmente; nunca versionar o .phar)
*.phar
