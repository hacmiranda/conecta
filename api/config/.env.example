# Configurações de Ambiente — Conecta CRPRS
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versionar o arquivo .env com valores reais.

# ===== AMBIENTE =====
# local | production. Define quais chaves *_LOCAL ou *_PROD são usadas.
# Sem valor (ou valor desconhecido) o sistema assume production.
APP_ENV=production

# ===== BANCO DE DADOS =====
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=db_conecta
DB_USER_LOCAL=root
DB_PASS_LOCAL=

DB_HOST_PROD=
DB_NAME_PROD=db_conecta
DB_USER_PROD=
DB_PASS_PROD=

# ===== EMAIL IMAP/SMTP =====
IMAP_USER_LOCAL=
IMAP_PASS_LOCAL=
SMTP_USER_LOCAL=
SMTP_PASS_LOCAL=
FROM_EMAIL_LOCAL=

IMAP_USER_PROD=
IMAP_PASS_PROD=
SMTP_USER_PROD=
SMTP_PASS_PROD=
FROM_EMAIL_PROD=

# Validação do certificado do servidor de e-mail (padrão: validar). Desligue (0) só se o servidor
# global usar certificado inválido. Para as caixas dos setores, a opção é por caixa (tela Configurar e-mail).
# IMAP_VALIDAR_CERTIFICADO_LOCAL=1
# SMTP_VALIDAR_CERTIFICADO_LOCAL=1
# IMAP_VALIDAR_CERTIFICADO_PROD=1
# SMTP_VALIDAR_CERTIFICADO_PROD=1

# ===== SEGURANÇA =====
# Gere chaves fortes: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_LOCAL=
CSRF_SECRET_LOCAL=
JWT_SECRET_PROD=
CSRF_SECRET_PROD=

# ===== MÓDULO / PAINEL AGREGADOR =====
# Lista de origens (scheme+host+porta) autorizadas a chamar a API via CORS
# e a incorporar este sistema em <iframe> (CSP frame-ancestors).
# Formato: lista separada por vírgula, sem espaços. Deixe em branco para usar o default embutido.
CORS_ALLOWED_ORIGINS_LOCAL=
CORS_ALLOWED_ORIGINS_PROD=

# Segredo compartilhado com o serviço central de identidade (SSO) do painel agregador.
# Usado para validar o token recebido em api/controllers/auth-sso.php.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
SSO_SHARED_SECRET_LOCAL=
SSO_SHARED_SECRET_PROD=

# ===== E-MAIL POR SETOR (caixas IMAP cadastradas em setor_emails) =====
# Chave usada para cifrar em repouso a senha IMAP de cada caixa de e-mail de setor.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
SETOR_EMAIL_ENCRYPTION_KEY_LOCAL=
SETOR_EMAIL_ENCRYPTION_KEY_PROD=

# ===== CLOUDFLARE TURNSTILE (CAPTCHA do login, só em produção) =====
# Segredo do site no painel da Cloudflare (a chave pública fica em api/config/turnstile.php e login.html).
# Sem ele, o login de produção funciona sem CAPTCHA e registra um erro no log.
TURNSTILE_SECRET_KEY_LOCAL=
TURNSTILE_SECRET_KEY_PROD=

# ===== INTEGRAÇÃO M2M (api/controllers/integracoes/abrir_chamado.php) =====
# Chave enviada no header X-API-KEY pelos sistemas satélites. Sem ela a integração fica desativada (503).
# Gere com: php -r "echo bin2hex(random_bytes(32));"
INTEGRATION_API_KEY_LOCAL=
INTEGRATION_API_KEY_PROD=

# ===== CRONS (api/cron/*.php) =====
# Pela linha de comando rodam sem chave. Por HTTP (ex.: cron-job.org) exigem esta chave,
# enviada só no header X-Cron-Key (?key= na URL não é aceito: vazaria em logs). Sem chave definida, o acesso HTTP fica bloqueado.
# Gere com: php -r "echo bin2hex(random_bytes(24));"
CRON_KEY_LOCAL=
CRON_KEY_PROD=

# ===== PESQUISA DE SATISFAÇÃO (METRICA360) =====
# Ao resolver/encerrar a demanda de um solicitante externo, o Conecta pede o convite ao METRICA360
# (api/services/pesquisa-satisfacao-service.php, entregue pelo cron enviar-fila.php).
# URL do METRICA360, sem barra final. Sem URL ou sem chave, os pedidos ficam na fila (status pendente).
METRICA360_URL_LOCAL=http://localhost/metrica360
METRICA360_URL_PROD=https://crp07.org.br/metrica360
# A MESMA chave de INTEGRACAO_CONECTA_API_KEY do .env do METRICA360 (mínimo 32 caracteres).
# Gere com: php -r "echo bin2hex(random_bytes(32));"
METRICA360_API_KEY_LOCAL=
METRICA360_API_KEY_PROD=
# Domínios internos (separados por vírgula): solicitantes com esses e-mails nunca recebem pesquisa.
PESQUISA_DOMINIOS_INTERNOS=crprs.org.br
