# Configurações de Ambiente — CRPDESK
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versionar o arquivo .env com valores reais.

# ===== BANCO DE DADOS =====
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=crpdesk
DB_USER_LOCAL=root
DB_PASS_LOCAL=

DB_HOST_PROD=
DB_NAME_PROD=crpdesk
DB_USER_PROD=
DB_PASS_PROD=

# ===== EMAIL IMAP/SMTP =====
IMAP_USER_LOCAL=
IMAP_PASS_LOCAL=
SMTP_USER_LOCAL=
SMTP_PASS_LOCAL=
FROM_EMAIL_LOCAL=

IMAP_USER_PROD=
IMAP_PASS_PROD=
SMTP_USER_PROD=
SMTP_PASS_PROD=
FROM_EMAIL_PROD=

# ===== SEGURANÇA =====
# Gere chaves fortes: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_LOCAL=
CSRF_SECRET_LOCAL=
JWT_SECRET_PROD=
CSRF_SECRET_PROD=
