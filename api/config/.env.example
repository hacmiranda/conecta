# Configurações de Ambiente — CRPDESK
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versionar o arquivo .env com valores reais.

# ===== BANCO DE DADOS =====
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=crpdesk
DB_USER_LOCAL=root
DB_PASS_LOCAL=***REMOVIDO***

DB_HOST_PROD=
DB_NAME_PROD=crpdesk
DB_USER_PROD=
DB_PASS_PROD=

# ===== EMAIL IMAP/SMTP =====
IMAP_USER_LOCAL=
IMAP_PASS_LOCAL=
SMTP_USER_LOCAL=
SMTP_PASS_LOCAL=
FROM_EMAIL_LOCAL=

IMAP_USER_PROD=
IMAP_PASS_PROD=
SMTP_USER_PROD=
SMTP_PASS_PROD=
FROM_EMAIL_PROD=

# ===== SEGURANÇA =====
# Gere chaves fortes: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_LOCAL=
CSRF_SECRET_LOCAL=
JWT_SECRET_PROD=
CSRF_SECRET_PROD=

# ===== MÓDULO / PAINEL AGREGADOR =====
# Lista de origens (scheme+host+porta) autorizadas a chamar a API via CORS
# e a incorporar este sistema em <iframe> (CSP frame-ancestors).
# Formato: lista separada por vírgula, sem espaços. Deixe em branco para usar o default embutido.
CORS_ALLOWED_ORIGINS_LOCAL=
CORS_ALLOWED_ORIGINS_PROD=

# Segredo compartilhado com o serviço central de identidade (SSO) do painel agregador.
# Usado para validar o token recebido em api/controllers/auth-sso.php.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
SSO_SHARED_SECRET_LOCAL=
SSO_SHARED_SECRET_PROD=

# ===== E-MAIL POR SETOR (caixas IMAP cadastradas em setor_emails) =====
# Chave usada para cifrar em repouso a senha IMAP de cada caixa de e-mail de setor.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
SETOR_EMAIL_ENCRYPTION_KEY_LOCAL=
SETOR_EMAIL_ENCRYPTION_KEY_PROD=

# ===== INTEGRAÇÃO M2M (api/controllers/integracoes/abrir_chamado.php) =====
# Chave enviada no header X-API-KEY pelos sistemas satélites. Sem ela a integração fica desativada (503).
# Gere com: php -r "echo bin2hex(random_bytes(32));"
INTEGRATION_API_KEY_LOCAL=
INTEGRATION_API_KEY_PROD=
