# Desabilitar listagem de diretórios
Options -Indexes

# Configurar charset UTF-8
AddDefaultCharset UTF-8

# Proteger arquivos sensíveis (segredos, dumps, logs, manifestos do composer/npm, documentação)
<FilesMatch "(?i)(\.(env|sql|log|md|lock|phar|bak|ini|sh)|^composer\.json|^package(-lock)?\.json|^\.git.*|^\.env.*)$">
    Require all denied
</FilesMatch>

# Bloquear scripts de diagnóstico/manutenção que não fazem parte da aplicação pública
<FilesMatch "^(check_db|migrate_db|test_php_input|test_integracao|composer-setup)\.php$">
    Require all denied
</FilesMatch>

# Pastas que nunca são servidas pela web: código interno, dependências, testes e documentação.
# (api/cron/ continua acessível: o cron externo chama por HTTP com a chave CRON_KEY_*.)
RedirectMatch 404 (?i)/(\.git|\.agent|\.claude|\.superpowers|\.playwright-mcp|docs|database|api/vendor|api/test|api/tests|api/services|api/middleware|api/config|frontend/node_modules)(/|$)
# Mockups: as páginas HTML podem ser vistas (só em desenvolvimento; a pasta não vai para produção),
# mas os geradores PHP nunca rodam pela web
RedirectMatch 404 (?i)/mockups/.*\.php$


# Permitir header Authorization e redirecionar
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_URI} ^/conecta/?$
RewriteRule ^(.*)$ /conecta/frontend/login.html [L,R=301]

# Cabeçalhos de Segurança Globais (SEGURANCA_SPEC.md)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # SAMEORIGIN é o fallback para navegadores que não suportam CSP frame-ancestors
    # (a política real de quem pode incorporar este módulo em <iframe> é a frame-ancestors abaixo).
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy
    # Permite: próprio domínio, Google Fonts, CDN do Chart.js/Alpine/Quill,
    # Cloudflare Turnstile, imagens inline (data:) para Quill editor
    # frame-ancestors: origens autorizadas a incorporar este módulo em <iframe>.
    # Produção: só 'self'. Acesso por localhost/127.0.0.1 (desenvolvimento): também as origens locais,
    # para o painel agregador de teste. Ao integrar com o painel agregador real, adicionar o domínio
    # de produção nas duas linhas E em CORS_ALLOWED_ORIGINS_* no api/config/.env.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net cdnjs.cloudflare.com challenges.cloudflare.com static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdn.jsdelivr.net cdnjs.cloudflare.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' challenges.cloudflare.com cdnjs.cloudflare.com cloudflareinsights.com; frame-src challenges.cloudflare.com blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
    <If "%{HTTP_HOST} =~ /^(localhost|127\.0\.0\.1)(:\d+)?$/">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net cdnjs.cloudflare.com challenges.cloudflare.com static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdn.jsdelivr.net cdnjs.cloudflare.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' challenges.cloudflare.com cdnjs.cloudflare.com cloudflareinsights.com; frame-src challenges.cloudflare.com blob:; frame-ancestors 'self' http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self';"
    </If>

    # HTTPS obrigatório no navegador por 1 ano (só quando a requisição já veio por HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

    # Restringe acesso a APIs do navegador desnecessárias
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
